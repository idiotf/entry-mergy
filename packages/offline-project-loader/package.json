{
  "name": "@entry-mergy/offline-project-loader",
  "description": ".ent file loader library used in Entry Mergy monorepo",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.5",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier -w '**/*.ts'",
    "typecheck": "tsc --noEmit",
    "build": "tsdown --publint",
    "prepack": "bun scripts/prepack && bun run build",
    "postpack": "bun scripts/postpack"
  },
  "dependencies": {
    "@entry-mergy/common-utils": "workspace:*",
    "@entry-mergy/entry-utils": "workspace:*",
    "@entry-mergy/project-loader-base": "workspace:*",
    "@entry-mergy/project-loader-types": "workspace:*",
    "@entry-mergy/stream-utils": "workspace:*",
    "tar-stream": "^3.2.0"
  }
}