{
  "name": "@entry-mergy/project-loader-base",
  "description": "Base implementation of project loader used in Entry Mergy monorepo",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fast-fifo": "^1.3.0",
    "@types/node": "^26.1.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.5",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier -w '**/*.ts'",
    "typecheck": "tsc --noEmit",
    "build": "tsdown --publint",
    "prepack": "bun scripts/prepack && bun run build",
    "postpack": "bun scripts/postpack"
  },
  "dependencies": {
    "@entry-mergy/async-iterable-controller": "workspace:*",
    "@entry-mergy/project-loader-types": "workspace:*"
  }
}