{
  "name": "@entry-mergy/entry-project-optimizer",
  "description": "Entry project minifier/compressor library used in Entry Mergy monorepo",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./binary": {
      "types": "./src/binary.ts",
      "import": "./src/binary.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "tsdown": "^0.22.5",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier -w 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "build": "tsdown src/index src/binary --publint",
    "prepack": "bun scripts/prepack && bun run build",
    "postpack": "bun scripts/postpack"
  },
  "dependencies": {
    "@entry-mergy/entry-utils": "workspace:*"
  }
}